# Atlassian (Confluence + Jira share the same site credentials)
ATLASSIAN_BASE_URL=https://devlight.atlassian.net
ATLASSIAN_USERNAME=your@email.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Aliases still supported (optional if ATLASSIAN_* set)
CONFLUENCE_BASE_URL=https://devlight.atlassian.net
CONFLUENCE_USERNAME=your@email.com
CONFLUENCE_API_TOKEN=your-atlassian-api-token
CONFLUENCE_DEFAULT_SPACE=PMO
CONFLUENCE_DEFAULT_PARENT=

# Jira — project key is required for jira commands (credentials fall back to ATLASSIAN_/CONFLUENCE_)
JIRA_BASE_URL=https://devlight.atlassian.net
JIRA_USERNAME=your@email.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=YOURPROJ

# Jira registry auto-sync (default ON)
# After assign/transition/create — refresh that issue in registry/jira/
# sessionStart hook + `make jira-sync-if-stale` — full pull if older than N hours
JIRA_REGISTRY_AUTO_SYNC=1
JIRA_REGISTRY_STALE_HOURS=4

# Tempo Timesheets Cloud — separate Bearer token (NOT the Atlassian API token)
# Create at: Tempo → Settings → API integration
TEMPO_API_TOKEN=
TEMPO_BASE_URL=https://api.tempo.io/4

# Google Workspace (optional — Drive/Docs; user OAuth recommended when folders are private)
# See secrets/README.md
GOOGLE_AUTH_MODE=auto
# Service account (optional):
GOOGLE_APPLICATION_CREDENTIALS=
# User OAuth desktop client (recommended for personal access):
GOOGLE_OAUTH_CLIENT_SECRETS=./secrets/google-oauth-client.json
GOOGLE_OAUTH_TOKEN=./secrets/google-oauth-token.json
# Default folder if not using config/google-directories.json --dir:
GOOGLE_DRIVE_FOLDER_ID=
# Optional: domain-wide delegation subject (Workspace user email) for service account only
GOOGLE_DELEGATED_USER=

# Fireflies.ai (optional — meeting transcripts / summaries / audio → docs/meeting-notes/)
# Create key: Fireflies → Integrations → Fireflies API
FIREFLIES_API_KEY=
FIREFLIES_GRAPHQL_URL=https://api.fireflies.ai/graphql
# Optional filter for sync-pull (title/sentences search), e.g. project name
FIREFLIES_KEYWORD=
FIREFLIES_KEYWORD_SCOPE=title
# Only sync meetings on/after this ISO timestamp (e.g. keep current delivery year)
FIREFLIES_FROM_DATE=2026-01-01T00:00:00.000Z
# Download audio.mp3 into each meeting folder (needs Pro+ for audio_url)
FIREFLIES_DOWNLOAD_AUDIO=1
